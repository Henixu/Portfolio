<section id="services" class="w-full py-16 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto">
    <h2
      class="reveal text-center text-4xl md:text-5xl leading-tight text-[var(--white)] mb-12 md:mb-16"
    >
      <span class="font-bold">What I build</span>{" "}<span
        class="font-light italic">for you</span
      >
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-5">
      {
        services.map((service, index) => (
          <article
            class="service-card reveal flex flex-col gap-3 rounded-2xl border border-[var(--white-icon-tr)] bg-[#1414149c] p-6"
            style={`--accent: ${service.accent}; --delay: ${index * 0.12}s`}
          >
            <span class="text-[var(--white-icon)]" set:html={service.icon} />
            <h3 class="text-[var(--white)] text-lg font-semibold">
              {service.title}
            </h3>
            <p class="text-[var(--white-icon)] text-sm leading-relaxed flex-grow">
              {service.description}
            </p>
            <span class="service-badge self-start">{service.badge}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>

<section
  id="contact"
  class="w-full py-16 md:py-24 border-t border-[#ffffff10]"
>
  <div class="max-w-3xl mx-auto text-center">
    <h2 class="reveal text-4xl md:text-6xl leading-tight text-[var(--white)]">
      <span class="font-bold">Ready to</span>{" "}<span
        class="font-light italic">launch</span
      >{" "}<span class="font-bold text-[var(--sec)] shiny-sec">your idea?</span
      >
    </h2>

    <p
      class="reveal mt-8 text-[var(--white-icon)] leading-relaxed"
      style="--delay: 0.1s"
    >
      Based in Tunis, available for ambitious projects and innovative
      collaborations.<br class="hidden sm:block" /> Guaranteed reply within 24 hours.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      {
        actions.map((action, index) => (
          <a
            href={action.href}
            target="_blank"
            rel="noopener noreferrer"
            class="action-pill reveal inline-flex items-center gap-3 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] py-2 pl-2 pr-5 text-sm text-[var(--white-icon)]"
            style={`--accent: ${action.accent}; --delay: ${0.2 + index * 0.1}s`}
          >
            <span class="action-icon" set:html={action.icon} />
            <span>{action.label}</span>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script is:inline>
  document.documentElement.classList.add("has-js");
</script>

<script>
  const revealed = document.querySelectorAll(".reveal");

  // Once the entrance animation has played, drop it so it stops
  // overriding the hover transform on cards and pills.
  const markDone = (el: Element) => {
    el.addEventListener("animationend", () => el.classList.add("reveal-done"), {
      once: true,
    });
  };

  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    revealed.forEach((el) => el.classList.add("reveal-done"));
  } else {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            markDone(entry.target);
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.25 }
    );

    revealed.forEach((el) => observer.observe(el));
  }
</script>

<style>
  .has-js .reveal {
    opacity: 0;
  }

  .has-js .reveal.is-visible {
    animation: reveal-up 0.6s cubic-bezier(0.16, 0.8, 0.24, 1) var(--delay, 0s)
      both;
  }

  .has-js .reveal.reveal-done {
    animation: none;
    opacity: 1;
  }

  @keyframes reveal-up {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .service-card {
    transition:
      border-color 0.25s ease,
      transform 0.25s ease,
      background-color 0.25s ease;
  }

  .service-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--accent) 45%, transparent);
    background-color: #181818e6;
  }

  .service-badge {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 11px;
    letter-spacing: 0.04em;
    padding: 5px 12px;
    border-radius: 9999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 28%, transparent);
  }

  .action-pill {
    transition:
      color 0.25s ease,
      border-color 0.25s ease,
      transform 0.2s ease;
  }

  .action-pill:hover {
    color: var(--white);
    border-color: color-mix(in srgb, var(--accent) 50%, transparent);
    transform: translateY(-2px);
  }

  .action-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 9999px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  @media (prefers-reduced-motion: reduce) {
    .has-js .reveal,
    .has-js .reveal.is-visible {
      opacity: 1;
      animation: none;
    }

    .service-card,
    .action-pill {
      transition: none;
    }

    .service-card:hover,
    .action-pill:hover {
      transform: none;
    }
  }
</style>
